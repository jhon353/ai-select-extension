{
  "manifest_version": 3,
  "name": "AI 划词解答",
  "version": "1.0.0",
  "description": "选中文字后快速获取 AI 解释、总结与答案，支持自定义接口地址、模型和 API Key。",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AI 划词解答"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
